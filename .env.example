# DingTalk application credentials
DINGTALK_CLIENT_ID=your_app_key_here
DINGTALK_CLIENT_SECRET=your_app_secret_here

# AgentFlowBus configuration
AGENT_ID=dingtalk-proxy
BUS_URL=nats://localhost:4222
SUBJECT_PREFIX=acp.v1
TENANT=

# Service configuration
MAX_CONCURRENCY=100
TOTAL_TIMEOUT=8.0
FALLBACK_TEXT=当前请求较多或服务暂时不可用，请稍后再试。

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Test mode: Enable to return test responses directly without backend AI service (true/false)
TEST_MODE=false
